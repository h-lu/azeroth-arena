{
  "name": "azeroth-arena-mvp0-rules-sandbox",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:cards": "node --import tsx tools/validate-card-schema.ts",
    "validate:unity-prototype": "node scripts/validate-unity-prototype.mjs",
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 0.0.0.0",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx server/index.ts",
    "dev:online": "node scripts/dev-online.mjs",
    "playtest:mechanics": "node --import tsx scripts/playtest-mechanics.mjs",
    "playtest:command-parity": "node --import tsx scripts/playtest-command-parity.mjs",
    "playtest:ai-bot": "node --import tsx scripts/playtest-ai-bot.mjs",
    "playtest:ai-director": "node --import tsx scripts/playtest-ai-director.mjs",
    "playtest:ai-vertical-slice": "node --import tsx scripts/playtest-ai-vertical-slice.mjs",
    "smoke:online": "node scripts/online-smoke.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "framer-motion": "^12.38.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.5"
  }
}
