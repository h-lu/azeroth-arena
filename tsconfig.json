{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "react": ["src/runtime/react.ts"],
      "react-dom/client": ["src/runtime/react-dom-client.ts"],
      "react/jsx-runtime": ["src/runtime/react-jsx-runtime.ts"],
      "react/jsx-dev-runtime": ["src/runtime/react-jsx-runtime.ts"]
    },
    "types": ["node", "vite/client"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "packages/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "server/**/*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vite.config.ts"
  ]
}
